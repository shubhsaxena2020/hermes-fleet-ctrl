{
  "name": "hermes-fleet-ctrl",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "TUI control plane for a fleet of remote tmux-backed agent sessions over SSH.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/websocket": "^8.3.1",
    "better-sqlite3": "^11.3.0",
    "blessed": "^0.1.81",
    "fastify": "^4.28.1",
    "node-pty": "^1.0.0",
    "ssh2": "^1.15.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/blessed": "^0.1.25",
    "@types/node": "^20.14.0",
    "@types/ssh2": "^1.15.1",
    "@types/ws": "^8.5.10",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^8.57.0",
    "prettier": "^3.3.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0",
    "ws": "^8.18.0"
  }
}
